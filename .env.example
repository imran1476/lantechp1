# ---- আসল OCR (ঐচ্ছিক) ----
# না দিলে অ্যাপ চলবে, কিন্তু আপলোড করা ছবি থেকে পড়ার বদলে কাল্পনিক নমুনা ডেটা দেখাবে
# (এবং স্ক্রিনে "ডেমো ডেটা" সতর্কবার্তা আসবে)।
GEMINI_API_KEY=""
# মডেলের নাম বদলাতে চাইলে (ডিফল্ট কোডে আছে)
# GEMINI_MODEL=""

# ---- লগইন / নিরাপত্তা ----
# সেশন সই করার গোপন কী। প্রোডাকশনে বাধ্যতামূলক (কমপক্ষে ৩২ অক্ষরের র‍্যান্ডম স্ট্রিং)।
# তৈরি করুন: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ডেমো অ্যাকাউন্ট: operator / reviewer / admin (সব কাল্পনিক ব্যবহারকারী)
# পাসওয়ার্ড না দিলে ডিফল্ট ডেমো পাসওয়ার্ড লগইন পেজে দেখানো হয়।
# আসল ব্যবহারে অবশ্যই বদলান এবং DEMO_MODE=false করুন।
# DEMO_PASSWORD=""
# OPERATOR_PASSWORD=""
# REVIEWER_PASSWORD=""
# ADMIN_PASSWORD=""
DEMO_MODE=true

# রিভার্স প্রক্সির (Render/Nginx ইত্যাদি) পেছনে চালালে true দিন (Secure কুকি ও ঠিক IP-র জন্য)
# TRUST_PROXY=true

# APP_URL: অ্যাপ যেখানে হোস্ট করা হয়েছে
APP_URL="MY_APP_URL"

# ---- ডেটা ----
# রেকর্ড (db.json) ও আপলোড করা ছবি রাখার ফোল্ডার (ডিফল্ট: ./data, .gitignore-এ আছে)
# BHOOMI_DATA_DIR=""
